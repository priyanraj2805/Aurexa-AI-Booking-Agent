POSTGRES_USER=postgres
POSTGRES_PASSWORD=dotstark_secure_pass
POSTGRES_DB=dotstark_v2

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Named Tunnels (Fixed Public URLs) — OPTIONAL but RECOMMENDED
# ─────────────────────────────────────────────────────────────────────────────
# Get these from: Cloudflare Zero Trust Dashboard > Networks > Tunnels
# 1. Add your domain to Cloudflare (or use a free subdomain from Cloudflare Pages)
# 2. Create two named tunnels:
#    - Backend API tunnel → public hostname: api.yourdomain.com
#    - Admin Panel tunnel → public hostname: admin.yourdomain.com
# 4. Copy each tunnel's token (from tunnel details > "Copy token")
# 5. Add tokens below (keep empty for quick tunnels with random URLs that change on restart)
CLOUDFLARE_TUNNEL_TOKEN_BACKEND=
CLOUDFLARE_TUNNEL_TOKEN_ADMIN=
