# ── Database (same PostgreSQL instance as the tenant backend) ──────────────
# Admin credentials: used ONLY for the super_admin schema (auth, MFA, RBAC)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dotstark_v2

# ── Read-only role: SELECT-only access to tenant tables (public schema) ────
# MUST match SUPER_ADMIN_READONLY_PASSWORD in backend/.env.docker
SUPER_ADMIN_READONLY_USER=super_admin_readonly
SUPER_ADMIN_READONLY_PASSWORD=readonly_dev_pass_2026

# ── Auth (Phase 1) ─────────────────────────────────────────────────────────
# Separate JWT secret — never reuse JWT_SECRET_KEY from the tenant backend
SUPER_ADMIN_JWT_SECRET_KEY=generate_a_strong_random_secret_here

# ── Env gates (stay FALSE until the final GA cutover in Phase 9) ───────────
INTERNAL_BRIDGE_ENABLED=false
TELEMETRY_ENABLED=false

# ── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3003
