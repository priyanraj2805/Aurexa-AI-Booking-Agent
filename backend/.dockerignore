# ── Python virtual environment (NEVER include in container) ──────────────────
# .venv contains your locally-installed packages. The Dockerfile re-installs
# them fresh inside the container using requirements.txt. Including .venv
# would massively bloat the image and likely cause import errors.
.venv/
venv/
env/

# ── Python cache files ───────────────────────────────────────────────────────
# Compiled Python bytecode — auto-regenerated, never needed in image.
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/

# ── Environment secrets ──────────────────────────────────────────────────────
# .env has localhost-based config (wrong for Docker).
# .env.docker is mounted via docker-compose env_file, not baked into image.
.env
.env.docker

# ── Dev/debug scripts (not needed in production container) ───────────────────
scratch/
check_*.py
repro_*.py
diagnostic_*.py
db_cleanup.py
*.debug
*.session

# ── Test files (not needed at runtime) ───────────────────────────────────────
tests/
pytest.ini
coverage/
htmlcov/

# ── Docs & markdown ──────────────────────────────────────────────────────────
*.md
docs/

# ── Git & IDE metadata ───────────────────────────────────────────────────────
.git/
.gitignore
.vscode/
.idea/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
server.log
