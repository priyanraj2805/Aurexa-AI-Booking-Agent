# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Example environment variables for Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=dotstark_secure_pass
# ↓ KEY CHANGE: "localhost" → "postgres" (the Docker service name)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dotstark_v2

# Email setup string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com

LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3-32b

AGENT_ENABLED=true

PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_SENDER_ID=your_plivo_sender_id

JWT_SECRET_KEY=dev-only-change-me-in-production-dotstark-2026-booking-agent

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# ↓ After first run, update this to your Cloudflare backend tunnel URL
GOOGLE_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/google-calendar/callback

MICROSOFT_CLIENT_ID=your_ms_client_id
MICROSOFT_CLIENT_SECRET=your_ms_client_secret
MICROSOFT_TENANT_ID=common
# ↓ After first run, update this to your Cloudflare backend tunnel URL
MICROSOFT_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/outlook-calendar/callback

# Dashboard callback redirect base (backend supports FRONTEND_BASE_URL alias, but FRONTEND_URL is preferred)
FRONTEND_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3002

# Public API base used for widget embed snippets/diagnostics (set to your backend tunnel URL + /api/v1)
PUBLIC_API_BASE=http://localhost:8005/api/v1

# Firebase Admin (phone OTP via widget) - REQUIRED for phone verification
# Get service account JSON from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON as a single line, or base64-encode it and use FIREBASE_SERVICE_ACCOUNT_B64
# Without this, POST /auth/security/otp/verify channel=phone will return 401 "Firebase Admin not configured"
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"dotstark-833ec",...}
# FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_json...
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
