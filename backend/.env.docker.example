# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Example environment variables for Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=dotstark_secure_pass
# ↓ KEY CHANGE: "localhost" → "postgres" (the Docker service name)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dotstark_v2

# Email setup string
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com

LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3-32b

AGENT_ENABLED=true

JWT_SECRET_KEY=dev-only-change-me-in-production-dotstark-2026-booking-agent

# Razorpay platform account (Route payouts) — test keys for TEST mode
RAZORPAY_KEY_ID=rzp_test_your_platform_key_id
RAZORPAY_KEY_SECRET=your_platform_key_secret
RAZORPAY_PARTNER_MODE=test
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_DEFAULT_AMOUNT_PAISE=0

# Razorpay Route provider payouts (platform account, TEST mode)
# Kill switch: false = all /dashboard/razorpay/route/* endpoints 404, no Route API calls.
RAZORPAY_ROUTE_ENABLED=false
RAZORPAY_ROUTE_API_BASE=https://api.razorpay.com
# Default platform commission in basis points (1000 = 10%). Integer math; persisted per transfer.
RAZORPAY_ROUTE_COMMISSION_BPS=1000

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# ↓ After first run, update this to your Cloudflare backend tunnel URL
GOOGLE_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/google-calendar/callback

MICROSOFT_CLIENT_ID=your_ms_client_id
MICROSOFT_CLIENT_SECRET=your_ms_client_secret
MICROSOFT_TENANT_ID=common
# ↓ After first run, update this to your Cloudflare backend tunnel URL
MICROSOFT_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/outlook-calendar/callback

# Dashboard callback redirect base (backend supports FRONTEND_BASE_URL alias, but FRONTEND_URL is preferred)
FRONTEND_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3002

# Public API base used for widget embed snippets/diagnostics (set to your backend tunnel URL + /api/v1)
PUBLIC_API_BASE=http://localhost:8005/api/v1

# Phone OTP is delivered via WhatsApp (Meta Cloud API) - REQUIRED for phone verification
# WHATSAPP_OTP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# WHATSAPP_OTP_ACCESS_TOKEN=your_whatsapp_access_token
