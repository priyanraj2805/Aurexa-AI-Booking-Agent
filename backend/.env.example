# ── Environment ───────────────────────────────────
# Set to false in production. Controls: cookie secure flag, OTP demo_code visibility.
DEBUG=true

# ── Database ──────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dotstark
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dotstark_v2

# ── SMTP (Email) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAILS_FROM_EMAIL=your_email@gmail.com

# ── LLM ──────────────────────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3-32b

# ── Security ─────────────────────────────────────
JWT_SECRET_KEY=generate_a_strong_random_secret_here

# ── Super Admin (Phase 0) ─────────────────────────
# Password for the SELECT-only DB role used by backend-super
SUPER_ADMIN_READONLY_PASSWORD=readonly_dev_pass_2026
# Bootstrap super admin account (created by the Phase 0 migration)
SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@dotstark.ai
SUPER_ADMIN_BOOTSTRAP_PASSWORD=SuperAdmin@2026!

# -------- Super Admin Internal Bridge (Phase 2) --------
# Lifecycle writes from the control plane. OFF by default; the bridge router
# is not registered while false (404 for all bridge calls).
INTERNAL_BRIDGE_ENABLED=false
INTERNAL_BRIDGE_SECRET=change_me_shared_secret
INTERNAL_BRIDGE_MAX_SKEW_SECONDS=300

# -------- Telemetry (Phase 2) --------
# Usage counters (bookings, AI tokens, API calls) into super_admin.usage_events.
# OFF by default; no-op while false.
TELEMETRY_ENABLED=false

# -------- Zavu SMS (phone OTP) --------
# Zavu Dashboard > Settings > API Keys + Senders > kd78m7agx48rpyegpfrmhp5rsx8dm8t9
# Test key zv_test_* simulates 202, live key zv_live_* delivers via sms_oneway shared pool
ZAVU_API_KEY=zv_live_your_live_key_here
ZAVU_SENDER_ID=kd78m7agx48rpyegpfrmhp5rsx8dm8t9
# ZAVU_BASE_URL=https://api.zavu.dev

# -------- Firebase Admin (phone OTP) --------
# Required for POST /auth/security/otp/verify channel=phone (legacy Firebase path, deprecated for Zavu)
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste JSON as single line or base64-encode for B64 variant
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"dotstark-833ec",...}
# FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_json
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json
