# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Example environment variables for Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dotstark_secure_pass
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dotstark_v2

# ─── Email (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=Booking Agent

# ─── LLM Configuration ───────────────────────────────────────────
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3-32b

# ─── Agent Settings ───────────────────────────────────────────────────────
AGENT_ENABLED=true

# ─── Security ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-only-change-me-in-production-dotstark-2026-booking-agent

# ─── Google Calendar Integration ─────────────────────────────────────
# Create OAuth credentials at: https://console.cloud.google.com/apits/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Update this to your public URL after deployment
GOOGLE_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/google-calendar/callback

# ─── Microsoft Outlook Calendar Integration ───────────────────────────
# Create OAuth app at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=your_ms_client_id
MICROSOFT_CLIENT_SECRET=your_ms_client_secret
MICROSOFT_TENANT_ID=common
# Update this to your public URL after deployment
MICROSOFT_REDIRECT_URI=http://localhost:8005/api/v1/dashboard/outlook-calendar/callback

# ─── Frontend URLs ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3002
FRONTEND_BASE_URL=http://localhost:3002
PUBLIC_API_BASE=http://localhost:8005/api/v1

# ─── Optional: Zoom Integration ────────────────────────────────
# Get credentials at: https://marketplace.zoom.us/
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret

# ─── Optional: WhatsApp (Meta) ────────────────────────────────
# Create app at: https://developers.facebook.com/
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ─── Redis (Optional - uses Docker service by default) ──────────
REDIS_URL=redis://redis:6379/0

# ─── Application ───────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO